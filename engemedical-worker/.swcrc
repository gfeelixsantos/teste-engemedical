{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "target": "es2021",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    },
    "externalHelpers": false
  },
  "module": {
    "type": "commonjs",
    "strictMode": false,
    "lazy": true
  },
  "sourceMaps": true,
  "exclude": [
    "node_modules",
    "dist",
    ".swc"
  ]
}
