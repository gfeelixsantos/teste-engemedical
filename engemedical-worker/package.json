    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts",
    "test:run": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --config jest.config.ts --runInBand",
    "test:aso-contracts": "node -r ts-node/register/transpile-only src/signature/aso-stamp-text.contract-test.ts && node -r ts-node/register/transpile-only src/signature/resolve-aso-metadata.contract-test.ts && node -r ts-node/register/transpile-only src/signature/pdf-signature-markers.contract-test.ts && node -r ts-node/register/transpile-only src/signature/aso-callback-status.contract-test.ts && node -r ts-node/register/transpile-only src/signature/aso-iti-validation.contract-test.ts && node -r ts-node/register/transpile-only src/signature/bry-verification.contract-test.ts && node -r ts-node/register/transpile-only src/signature/bry-verification-report.contract-test.ts && node -r ts-node/register/transpile-only src/scrapers/iti-validation-request-shape.contract-test.ts && node -r ts-node/register/transpile-only src/scrapers/iti-validation-error-shape.contract-test.ts",
    "test:exam-contracts": "node -r ts-node/register/transpile-only src/signature/exam-signature-eligibility.contract-test.ts",
    "diag:aso-queue": "node src/scripts/diag-aso-queue.js",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
