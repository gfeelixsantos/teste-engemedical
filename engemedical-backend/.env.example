# Engemedical Connect Backend - Variáveis de Ambiente

## Aplicação
NODE_ENV=development
PORT=3333
TZ=America/Sao_Paulo
CORS_ORIGIN=https://engemedical-connect-frontend.vercel.app,http://localhost:3000

## Banco de Dados
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DATABASE=cmso-agendamento
MONGO_COLLECTION=schedulings

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/engemedical-connect?schema=public

## Azure
AZURE_CONNECTION_STRING_BLOB=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
# AZURE_LEGACY_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=cmsodocuments;AccountKey=your_key;EndpointSuffix=core.windows.net

## AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

## Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-service-account.json

## Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_role_key

## Worker
WORKER_BASE_URL_PROD=https://engemedical-connect-worker.fly.dev
WORKER_INTERNAL_BASE_URL=http://127.0.0.1:3334
INTERNAL_WORKER_TOKEN=your_worker_token

## Scrapers
SCRAPER_CRON_ENABLED=false

## SFTP Integrator - Grupo Tora
SFTP_INTEGRATOR_GRUPO_TORA_HOST=sftp.example.com
SFTP_INTEGRATOR_GRUPO_TORA_PORT=2222
SFTP_INTEGRATOR_GRUPO_TORA_USERNAME=grupotora
SFTP_INTEGRATOR_GRUPO_TORA_AUTH_METHOD=password
SFTP_INTEGRATOR_GRUPO_TORA_PASSWORD=change_me
SFTP_INTEGRATOR_GRUPO_TORA_PRIVATE_KEY=
SFTP_INTEGRATOR_GRUPO_TORA_PRIVATE_KEY_PASSPHRASE=
SFTP_INTEGRATOR_GRUPO_TORA_FINGERPRINT=SHA256:example
SFTP_INTEGRATOR_GRUPO_TORA_REMOTE_PATH=/planilhas
SFTP_INTEGRATOR_GRUPO_TORA_FILE_PATTERN=LOG_INTEGRACAO_*.xlsx
SFTP_INTEGRATOR_GRUPO_TORA_DOWNLOAD_DIR=data/sftp-integrator/grupo-tora/incoming
SFTP_INTEGRATOR_GRUPO_TORA_CRON_ENABLED=true
SFTP_INTEGRATOR_GRUPO_TORA_REPORT_EMAIL_TO=operacionalbh@engemedical.com,operacionalctg@engemedical.com,operacionalce@engemedical.com,operacional@sa.engemedical.com,felix.devx@gmail.com
SFTP_INTEGRATOR_GRUPO_TORA_SOC_ENABLED=false
SFTP_INTEGRATOR_GRUPO_TORA_SOC_LIMIT=3
SFTP_INTEGRATOR_GRUPO_TORA_SOC_DELAY_MS=2500
SFTP_INTEGRATOR_GRUPO_TORA_SOC_LOOKUP_COMPANY_CODE=2182291
SOC_ED_CADASTRO_FUNCIONARIO_CPF_CODIGO=217191
SOC_ED_CADASTRO_FUNCIONARIO_CPF_CHAVE=

## Web Push
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com

## JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# ============================================
# Cloudflare R2 Storage (para arquivos SFTP)
# ============================================
## Cloudflare Account ID
R2_ACCOUNT_ID=9146a0e802de7e5843c9ab0f5e63f2b4

## Cloudflare R2 - Service Alert Credenciais
# Para criar Service Alert: Cloudflare Dashboard → R2 → Service Alerts → Create
# Bucket: sftp-relatorios | Permissões: Read, Write
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

## Cloudflare R2 - Bucket Configuration
R2_BUCKET_NAME=sftp-relatorios

## Cloudflare API Token (para Workers, Queues)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=9146a0e802de7e5843c9ab0f5e63f2b4
CLOUDFLARE_QUEUE_NAME=email-service

## Cloudflare Queue Worker
SFTP_EMAIL_WORKER_ENABLED=false
EMAIL_CONFIG_HOST=smtp.titan.email
EMAIL_CONFIG_PORT=465
EMAIL_CONFIG_USER=suporte@lp.engemedical.com
EMAIL_CONFIG_PASS=your_smtp_password
EMAIL_FROM_DEFAULT="Engemedical <suporte@lp.engemedical.com>"
